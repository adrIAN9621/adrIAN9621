# Variabile pentru interpolarea Compose (docker compose --env-file .env ...).
# Copiați în /srv/apps/asistenta/.env și ajustați. Permisiuni recomandate: chmod 600.

APP_NAME=asistenta
APP_IMAGE=carpatica-asistenta:20261030-1
APP_DOMAIN=asistenta.carpaticaferoviar.ro

# Căi absolute, persistente, pe server (proprietar: contul platformei).
APP_DATA_DIR=/srv/apps/asistenta/data
APP_ENV_FILE=/srv/apps/asistenta/app.env

# Rețeaua Docker comună pe care ascultă Caddy.
CADDY_NETWORK=web

# Limită de memorie pentru container.
APP_MEMORY_LIMIT=512m
