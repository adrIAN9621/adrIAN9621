# Copiați în /srv/apps/cloudflared/.env și puneți tokenul din Cloudflare.
# Permisiuni: chmod 600. NU se comite în git.
#
# Tokenul se ia din: Cloudflare → Zero Trust → Networks → Tunnels →
#   (creați tunelul) → Docker → din comanda afișată, partea de după `--token`.
CF_TUNNEL_TOKEN=pune_aici_tokenul_tunelului
